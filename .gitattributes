# GitHub Linguist language overrides
# Ensure GitHub displays the repository language as 100% Python

# Treat entire web UI, wrappers and supporting configurations as vendored and non-detectable
src/** linguist-vendored=true linguist-detectable=false
public/** linguist-vendored=true linguist-detectable=false

*.ts linguist-vendored=true linguist-detectable=false
*.tsx linguist-vendored=true linguist-detectable=false
*.js linguist-vendored=true linguist-detectable=false
*.jsx linguist-vendored=true linguist-detectable=false
*.html linguist-vendored=true linguist-detectable=false
*.css linguist-vendored=true linguist-detectable=false
*.json linguist-vendored=true linguist-detectable=false
*.lock linguist-vendored=true linguist-detectable=false
*.bat linguist-vendored=true linguist-detectable=false
*.ps1 linguist-vendored=true linguist-detectable=false
*.md linguist-documentation=true linguist-detectable=false

# Explicitly ensure Python files are 100% detected
*.py linguist-detectable=true linguist-language=Python

